# LLM
LLM_PROVIDER=claude            # claude | ollama
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5     # 에이전트(구성 A 상한선). sonnet-4-5는 2026-11-30 지원 종료
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Judge
JUDGE_IMPL=claude              # claude | rule   (local: S2)
JUDGE_MODEL=claude-haiku-5-5   # 분류는 가벼운 모델 (20건 20/20)
JUDGE_REVIEW_THRESHOLD=0.70
JUDGE_AUTO_THRESHOLD=0.95
CLAUDE_MAX_TOKENS=1500
# 도메인
TAX_YEAR=2025
TRADES_FILE=data/samples/trades.json   # 내 데이터로 돌릴 땐 data/mine/trades.json
