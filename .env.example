# LLM
LLM_PROVIDER=claude            # claude | ollama
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5     # 에이전트(구성 A 상한선). sonnet-4-5는 2026-11-30 지원 종료
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Judge
JUDGE_IMPL=claude              # claude | rule   (local: S2)
JUDGE_MODEL=claude-haiku-5-5   # 분류는 가벼운 모델 (20건 20/20)
JUDGE_REVIEW_THRESHOLD=0.70
JUDGE_AUTO_THRESHOLD=0.85           # SCRUM-22: 200문장×5회 보정 결과 (0.95→0.85). 근거는 README 평가 절
CLAUDE_MAX_TOKENS=1500
# 도메인
TAX_YEAR=2025
TRADES_FILE=data/samples/trades.json
TRACE_DB=data/trace.db                 # agent_trace SQLite. S2에서 PostgreSQL/Oracle로   # 내 데이터로 돌릴 땐 data/mine/trades.json
# F07 답변 조립기 (SCRUM-35). off면 에이전트 원문을 draft로 그대로 내보낸다 (대조 실험용)
ANSWER_ASSEMBLER=on
# F01-6 동기 타임아웃 (SCRUM-19). 넘으면 FAILED/E-TIMEOUT, 숫자·상태 문장은 코드로 조립해 전달
SYNC_TIMEOUT_SEC=30
# 에이전트 최종 답변 형식: notes(기본, 상담원 메모) | json(조립기 이전 기준) | prose(절제 실험)
AGENT_FINAL_FORMAT=notes
# 조립기 모델 (10/26 홀드아웃: Opus와 문장 점수 차이 없음, 지연 감소)
ASSEMBLER_MODEL=claude-sonnet-5-5  # 기본값. same = 에이전트와 같은 모델
# 고객 산정 방식 저장 (SCRUM-47). 평가는 이 DB를 쓰지 않는다(:memory:)
METHOD_DB=data/method.db
# 선택제 계좌 방식 변경 규칙: once(기본, 계좌·연도당 1회 확정) | free. NH 원문 규칙은 SCRUM-3 확인 후 확정
METHOD_CHANGE_RULE=once
# 법제처 Open API OC (open.law.go.kr에서 신청, 이메일 @ 앞부분) — scripts/build_corpus.py --fetch (SCRUM-31)
LAW_OC=
# RAG (SCRUM-32·33). 임베딩은 로컬 Ollama bge-m3 — 폐쇄망 전제라 외부 API를 쓰지 않는다
EMBEDDER=ollama
EMBED_MODEL=bge-m3
OLLAMA_URL=http://localhost:11434
RAG_STORE=local
# 벡터 1위 코사인이 이보다 낮으면 '약함' → 질문 재작성 1회 (eval.retrieval 출력으로 보정)
WEAK_COS=0.5
# 재작성: dict(사전만, 비용 0) | llm(사전 후 그래도 약하면 REWRITE_MODEL)
REWRITE=dict
# 재색인 API 토큰
ADMIN_TOKEN=
# F04 Text-to-SQL (SCRUM-26·27). sqlite(기본) | pg
TRADE_DB_KIND=sqlite
# SQLite 거래 DB 파일 (scripts/load_trade_db.py 로 생성, 읽기 전용으로 열림). 비우면 TRADES_FILE 로 메모리 DB
TRADE_DB=
# 쿼리 시간 상한(초). 넘으면 E-SQL-EXEC
SQL_TIMEOUT_SEC=5
# pg 일 때 읽기 전용 계정 DSN (db/readonly_user.sql 의 tax_ro)
PG_TRADE_RO_DSN=
